{% from '_macros.html.j2' import external_link %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ document.basics.full_name }} — Resume</title>
  <style>{{ css_content }}</style>
  {% if interactive %}
  <style>
    [data-resume-section] { cursor: pointer; border-radius: 2px; }
    [data-resume-section]:hover { background: rgba(0, 51, 153, 0.05); }
  </style>
  {% endif %}
</head>
<body>
  <main class="resume-page">
    <aside class="resume-sidebar" data-resume-section="basics">
      <h1 class="resume-name">{{ document.basics.full_name }}</h1>
      {% if document.basics.summary %}
        <p class="resume-role">{{ document.basics.summary[:120] }}{% if document.basics.summary|length > 120 %}...{% endif %}</p>
      {% endif %}

      <section class="sidebar-section">
        <h2 class="sidebar-title">Contact</h2>
        <ul class="sidebar-list">
          {% if document.basics.email %}
            <li><a href="mailto:{{ document.basics.email }}">{{ document.basics.email }}</a></li>
          {% endif %}
          {% if document.basics.phone %}
            <li>{{ document.basics.phone }}</li>
          {% endif %}
          {% if document.basics.location %}
            <li>{{ document.basics.location }}</li>
          {% endif %}
          {% if document.basics.syncques_url %}
            <li>{{ external_link('syncques', document.basics.syncques_url) }}</li>
          {% endif %}
          {% for platform, url in document.basics.social_links.items() %}
            {% if url %}
              <li>{{ external_link(platform, url) }}</li>
            {% endif %}
          {% endfor %}
        </ul>
      </section>

      {% if document.sections.skills.flat or document.sections.skills.categorized %}
        <section class="sidebar-section" data-resume-section="skills">
          <h2 class="sidebar-title">Skills</h2>
          {% if document.sections.skills.categorized %}
            {% for category, skills in document.sections.skills.categorized.items() %}
              {% for skill in skills %}
                <span class="skill-pill">{{ skill }}</span>
              {% endfor %}
            {% endfor %}
          {% else %}
            {% for skill in document.sections.skills.flat %}
              <span class="skill-pill">{{ skill }}</span>
            {% endfor %}
          {% endif %}
        </section>
      {% endif %}
    </aside>

    <div class="resume-main">
      {% if document.basics.summary %}
        <section class="resume-section" data-resume-section="basics">
          <h2 class="resume-section-title">Profile</h2>
          <p class="resume-summary">{{ document.basics.summary }}</p>
        </section>
      {% endif %}

      {% if document.sections.experience %}
        <section class="resume-section" data-resume-section="experience">
          <h2 class="resume-section-title">Experience</h2>
          {% for exp in document.sections.experience %}
            <article class="entry">
              <div class="entry-header">
                <div>
                  <h3 class="entry-title">{{ exp.title }}</h3>
                  <p class="entry-subtitle">{{ exp.company }}{% if exp.location %}, {{ exp.location }}{% endif %}</p>
                </div>
                <div class="entry-date">{{ exp.start_date or '' }}{% if exp.start_date or exp.end_date %} — {% endif %}{{ exp.end_date or 'Present' }}</div>
              </div>
              {% if exp.description %}
                <ul class="entry-bullets">
                  {% for line in exp.description.replace('\\n', '\n').split('\n') %}
                    {% set bullet = line.strip().lstrip('•').lstrip('-').lstrip('–').strip() %}
                    {% if bullet %}
                      <li>{{ bullet }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              {% endif %}
            </article>
          {% endfor %}
        </section>
      {% endif %}

      {% if document.sections.projects %}
        <section class="resume-section" data-resume-section="projects">
          <h2 class="resume-section-title">Projects</h2>
          {% for proj in document.sections.projects %}
            <article class="entry">
              <h3 class="entry-title">{{ proj.title }}</h3>
              {% if proj.description %}
                <ul class="entry-bullets">
                  {% for line in proj.description.replace('\\n', '\n').split('\n') %}
                    {% set bullet = line.strip().lstrip('•').lstrip('-').lstrip('–').strip() %}
                    {% if bullet %}
                      <li>{{ bullet }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              {% endif %}
            </article>
          {% endfor %}
        </section>
      {% endif %}

      {% if document.sections.education %}
        <section class="resume-section" data-resume-section="education">
          <h2 class="resume-section-title">Education</h2>
          {% for edu in document.sections.education %}
            <article class="entry">
              <div class="entry-header">
                <div>
                  <h3 class="entry-title">{{ edu.institution }}</h3>
                  <p class="entry-subtitle">{{ edu.degree }}{% if edu.field_of_study %} in {{ edu.field_of_study }}{% endif %}</p>
                </div>
                <div class="entry-date">{{ edu.start_date or '' }}{% if edu.start_date or edu.end_date %} — {% endif %}{{ edu.end_date or 'Present' }}</div>
              </div>
            </article>
          {% endfor %}
        </section>
      {% endif %}

      {% if document.sections.achievements %}
        <section class="resume-section" data-resume-section="achievements">
          <h2 class="resume-section-title">Achievements</h2>
          {% for ach in document.sections.achievements %}
            <article class="entry">
              <h3 class="entry-title">{{ ach.title }}{% if ach.organization %} — {{ ach.organization }}{% endif %}</h3>
              {% if ach.description %}
                <p class="resume-summary">{{ ach.description }}</p>
              {% endif %}
            </article>
          {% endfor %}
        </section>
      {% endif %}
    </div>
  </main>
</body>
</html>